[Unit]
Description=GranEmpresa inventory service
After=network.target

[Service]
Type=simple
User=granempresa
Group=granempresa
WorkingDirectory=/srv/granempresa/app
Environment=PORT=8080
Environment=DATABASE_URL=postgres://stockiapp:stockiapp@127.0.0.1:5432/stockiapp?sslmode=disable
ExecStart=/srv/granempresa/app/granempresa
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
